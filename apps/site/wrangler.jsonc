{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordless",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/act",
      "/",
      "/top",
      "/@*",
      "/p/*",
      "/llms.txt",
      "/skill.md",
      "/heartbeat.md",
      "/a/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordless-prod",
      "database_id": "1f2052f8-da56-450e-8181-f1924c95a834",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
  "env": {
    // Bindings aren't inherited, so staging repeats every one of them.
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wordless-staging",
          "database_id": "054ae7be-afd0-4d11-beb7-d06c80f35007",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
