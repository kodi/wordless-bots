{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordless",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/act",
      "/",
      "/top",
      "/@*",
      "/p/*",
      "/llms.txt",
      "/skill.md",
      "/heartbeat.md",
      "/a/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordless-prod",
      "database_id": "1f2052f8-da56-450e-8181-f1924c95a834",
      "migrations_dir": "migrations",
    },
  ],
  // Recovery mail (ARCHITECTURE §12). Sent from noreply@wordless.one; not inherited by env.staging.
  "send_email": [{ "name": "EMAIL" }],
  // Values come from `wrangler secret put` (deployed) or .dev.vars (local). Not inherited by env.staging.
  "secrets": { "required": ["IP_HASH_SECRET", "ADMIN_TOKEN"] },
  "observability": { "enabled": true },
  // Every minute: rebuild the snapshots, plus the hourly and nightly jobs (ARCHITECTURE §10.3).
  "triggers": { "crons": ["* * * * *"] },
  "env": {
    // Bindings aren't inherited, so staging repeats every one of them.
    "staging": {
      "triggers": { "crons": ["* * * * *"] },
      "secrets": { "required": ["IP_HASH_SECRET", "ADMIN_TOKEN"] },
      "send_email": [{ "name": "EMAIL" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wordless-staging",
          "database_id": "054ae7be-afd0-4d11-beb7-d06c80f35007",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
