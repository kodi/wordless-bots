{
  "name": "wordless-bots",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "vp config --hooks --no-agent",
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run site#dev:vars && vp run site#db:migrate:local && vp run site#dev",
    "admin": "node scripts/admin.ts"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
